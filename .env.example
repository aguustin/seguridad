# Config para docker-compose.yml (producción). Copiar a `.env` en esta
# misma carpeta y completar con valores reales — ese archivo NO se sube a
# git (ver .gitignore).
#
#   cp .env.example .env

# Dominio real donde va a vivir el backend (con DNS ya apuntando a este
# servidor). Caddy pide el certificado TLS automáticamente para este nombre.
DOMAIN=api.tudominio.com

# Postgres — usados tanto por el contenedor de postgres como por el backend
# para conectarse a él (ver docker-compose.yml).
DB_NAME=seguridad_barrios
DB_USER=postgres
DB_PASSWORD=cambiar_por_una_contraseña_larga_y_unica

# Secreto para firmar los JWT de sesión — tiene que ser largo, aleatorio y
# distinto al que se usa en desarrollo. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_unico
