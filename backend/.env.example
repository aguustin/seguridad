PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seguridad_barrios
DB_USER=postgres
DB_PASSWORD=tu_password

JWT_SECRET=cambia_este_secret_por_uno_seguro_en_produccion
JWT_EXPIRES_IN=7d

# Directorio de uploads
UPLOADS_DIR=uploads

# Face recognition threshold (0-1, menor = más estricto)
FACE_MATCH_THRESHOLD=0.5

# Timeout (ms) para extraer un descriptor facial de una imagen
FACE_EXTRACT_TIMEOUT_MS=20000
